# Copy this file to .env and fill in the key for the provider you use.
# The CLI loads .env automatically at startup; real environment variables
# exported in your shell take precedence over this file.

# OpenRouter is the default provider — it fronts any model you like.
OPENROUTER_API_KEY=sk-or-v1-...

# Only needed for `--provider anthropic` (or as the automatic fallback when
# OPENROUTER_API_KEY is unset).
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (equivalent to --provider / --model on the CLI).
# SCOREOCR_PROVIDER=openrouter
# SCOREOCR_MODEL=google/gemini-3.1-pro-preview
